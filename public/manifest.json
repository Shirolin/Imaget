{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.1.2",
  "description": "__MSG_extDesc__",
  "author": "shirolin",
  "homepage_url": "https://github.com/Shirolin/Imaget",
  "short_name": "Imaget",
  "default_locale": "en",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": [
    "downloads",
    "activeTab",
    "storage",
    "contextMenus",
    "sidePanel",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Imaget",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-loader.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "*.js",
        "*.css",
        "*.svg",
        "*.png",
        "*.ico"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
