{
  "name": "imaget",
  "private": true,
  "version": "1.1.1",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync-version": "tsx scripts/sync-version.ts",
    "build:docs": "tsx scripts/build-docs.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json,md}\"",
    "lint": "eslint .",
    "type-check": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run sync-version && npm run build:docs && vite build",
    "build:check": "npm run format && npm run lint && npm run type-check && npm run test && npm run build",
    "release": "bumpp && npm run build:check",
    "watch": "vite build --watch",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mantine/modals": "^8.3.18",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@eslint/js": "^9.39.4",
    "@mantine/core": "^8.3.17",
    "@mantine/hooks": "^8.3.17",
    "@tabler/icons-react": "^3.40.0",
    "@types/chrome": "^0.1.40",
    "@types/jszip": "^3.4.0",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "bumpp": "^11.0.1",
    "crx": "^5.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.1.1",
    "jszip": "^3.10.1",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.0",
    "vitest": "^3.2.1"
  }
}
